#!/usr/bin/env bash
# Caveman CLI. Targets bash 3.2, which is what /bin/bash is on macOS.
set -euo pipefail

# Resolved before sourcing anything: this script is normally reached through a
# symlink in PATH, so $0's directory is not where the libraries are. `readlink
# -f` is GNU-only, hence the loop.
caveman_entry=$0
while [ -L "$caveman_entry" ]; do
  caveman_link=$(readlink "$caveman_entry")
  case $caveman_link in
    /*) caveman_entry=$caveman_link ;;
    *) caveman_entry=$(dirname "$caveman_entry")/$caveman_link ;;
  esac
done
CAVEMAN_BIN_DIR=$(cd "$(dirname "$caveman_entry")" && pwd -P)

# shellcheck source=lib/output.sh
. "$CAVEMAN_BIN_DIR/lib/output.sh"
# shellcheck source=lib/paths.sh
. "$CAVEMAN_BIN_DIR/lib/paths.sh"

init_paths "$CAVEMAN_BIN_DIR"

# shellcheck source=lib/port.sh
. "$CAVEMAN_HOME/bin/lib/port.sh"
# shellcheck source=lib/health.sh
. "$CAVEMAN_HOME/bin/lib/health.sh"
# shellcheck source=lib/daemon.sh
. "$CAVEMAN_HOME/bin/lib/daemon.sh"
# shellcheck source=lib/client.sh
. "$CAVEMAN_HOME/bin/lib/client.sh"

usage() {
  say "caveman — a compression proxy for LLM requests"
  say ""
  say "usage:"
  say "  caveman up              start the proxy in the background"
  say "  caveman down            stop the proxy"
  say "  caveman status          report whether the proxy is running"
  say "  caveman <client> [...]  start the proxy, then launch a client"
  say ""
  say "clients:"
  names=$(client_names)
  if [ -n "$names" ]; then
    printf '  %s\n' $names
  else
    say "  (none installed)"
  fi
}

main() {
  command=${1:-}
  [ "$#" -gt 0 ] && shift

  case $command in
    up)
      init_port
      start_server
      ;;
    down)
      init_port
      stop_server
      ;;
    status)
      init_port
      report_status
      ;;
    help | --help | -h)
      usage
      ;;
    '')
      usage >&2
      exit "$EXIT_USAGE"
      ;;
    *)
      if has_client "$command"; then
        init_port
        launch_client "$command" "$@"
      else
        warn "caveman: unknown command \"$command\""
        usage >&2
        exit "$EXIT_USAGE"
      fi
      ;;
  esac
}

main "$@"
